---
layout: blank
---

<style><%- inlineScss('/styles/base.scss'); %></style>

<%- partial('head/scripts', locals); %>

<%- partial('header', {
  ...locals,
  inlineStyles: true,
  inlineSVGs: true,
}); %>

<main class="<%- (locals.pageClasses) ? locals.pageClasses.toString().replace(/,/g,' ') : '' %>">
  <% if (!locals.homepage) { %>
    <header class="main-header <%- (locals.pageClasses) ? locals.pageClasses.toString().replace(/,/g,' ') : '' %>">
      <h1 itemprop="headline" class="name content">
        <% if (locals.altTitle !== undefined) { %>
          <%- noWidows(locals.altTitle); %>
        <% } else if (locals.title !== undefined) { %>
          <%- noWidows(locals.title); %>
        <% } %>
      </h1>
    </header>
  <% } %>
  <% if (locals.description && !locals.homepage) { %>
    <div class="content description" itemprop="description">
      <p>
        <%- locals.description %>
      </p>
    </div>
  <% } %>

  <%- content %>

</main>

<%- partial('footer', { ...locals, deferStyles: true }); %>
