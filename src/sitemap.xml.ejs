<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="https://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="https://www.google.com/schemas/sitemap-image/1.1"
        xmlns:mobile="https://www.google.com/schemas/sitemap-mobile/1.0"
        xmlns:news="https://www.google.com/schemas/sitemap-news/0.9"
        xmlns:xhtml="https://www.w3.org/1999/xhtml"
  ><%
    for(let i = 0; i < locals.pages.length; i++) {
      const page = locals.pages[i];
      const date = page.data.date || new Date(locals.siteData.buildDateTime);
      // UTC: front-matter dates parse as UTC midnight; local getters shift them a day west of UTC.
      const dateOutput = `${date.getUTCFullYear()}-${('00' + (date.getUTCMonth() + 1)).slice(-2)}-${('00' + date.getUTCDate()).slice(-2)}`;
      if(page.data.robots !== false) {
  %>
  <url>
    <loc><%- locals.siteData.domain %><%- page.url %></loc>
    <lastmod><%- dateOutput %></lastmod>
    <priority><%- page.data.priority %></priority>
    <changefreq>yearly</changefreq>
  </url><%
      }
    }
  %>
</urlset>