      <option value="no-fill" selected>No Fill</option>
      <option value="fill-gray">Fill Gray</option>
      <option value="fill-color">Fill Color</option>
      <option value="epileptic">Epileptic</option>
    </select>
    <label for="alpha-fill">
      <input id="alpha-fill" type="checkbox">Fill Transparency
    </label>
    <label for="fast-slow">
