---
title: "Drawing with Microsoft Paint"
description: "If you want a place to goof around and draw. Here’s your place."
date: 2018-07-18
priority: 0.8
ogImage:
  selector: '#canvas'
  alt: 'Colorful brush strokes on the Paint canvas'
  wait: 500
  actions:
    - fill: ['#stroke-slider', '28']
    - click: 'color-sample[data-color=''hot-pink'']'
    - drag: ['#canvas', [[0.06, 0.75], [0.18, 0.25], [0.3, 0.7], [0.42, 0.2], [0.54, 0.75]]]
    - click: 'color-sample[data-color=''orange'']'
    - drag: ['#canvas', [[0.1, 0.45], [0.35, 0.4], [0.6, 0.5], [0.9, 0.35]]]
    - click: 'color-sample[data-color=''nest-blue'']'
    - drag: ['#canvas', [[0.55, 0.85], [0.68, 0.2], [0.8, 0.8], [0.94, 0.15]]]
layout: base
styles:
  - 'main'
  - 'posts/paint'
scripts:
  - 'posts/paint'
---

<div class="content">
  <canvas id="canvas"></canvas>
</div>

<div class="content">
  <div class="color-palette p">
    <main-color class="color"></main-color>
    <%# colors filled by js %>
  </div>

  <div class="stroke-size-palette p">
    <div class="slider-container">
      <input id="stroke-slider" type="range" min="1" max="200" value="5" step="1" aria-label="Stroke size">
    </div>
    <main-stroke>
      <span>1px</span>
    </main-stroke>
  </div>

  <div class="shape-palette p">
    <label>
      <input id=circle type=radio name=shape value=circle checked=checked /> Circle
    </label>
    <label>
      <input id=square type=radio name=shape value=square /> Square
    </label>
  </div>
</div>