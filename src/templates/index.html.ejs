---
title: "Home"
description: "Brian Anders is an Engineering Manager in the tech industry. I'm also a YouTuber, Podcaster, and
Musician."
priority: 1.0
homepage: true
pageClasses:
- 'main'
- 'home'
layout: base
styles:
- 'main'
scripts:
- 'homepage'
---


<%- partial('head/styles', { ...locals, path: 'homepage', inlineStyles: true }) %>


<section class="hero">
  <div class="content">
    <p class="overline text-primary">Engineer · YouTuber · Podcaster · Musician</p>
    <h1 class="hero__title">Hi, I'm <em>Brian Anders</em>.</h1>
    <p class="hero__lede">
      I'm an engineering manager in the tech industry. In my off-hours I make
      drum covers, host a Batman-history podcast, and cook up small code
      experiments — most of which live somewhere on this site.
    </p>
    <div class="hero__cta cluster">
      <%- link('About me', { href: '/about/', class: 'button button-link primary' }); %>
      <%- link('Recent posts', { href: '#recent-posts', class: 'button button-link' }); %>
    </div>
  </div>
</section>


<section class="contributions">
  <div class="content">
    <h2 class="h5 overline">What I make</h2>
  </div>
  <div class="content deck">
    <%
      const model = [
        {
          heading: "Bat Lessons",
          image: "/images/about/contributions/batlessons.webp",
          copyBlock: `Batman history, presented by ${inlineLink('Alex Cash', { href: 'https://alex.cash', external: true })} and myself.`,
          links: [
            {
              label: "Website",
              url: locals.batLessons,
            },
            {
              label: "YouTube",
              url: locals.batLessonsYT,
            }
          ]
        }, {
          heading: "Banders Drums",
          image: "/images/drums/logo.png",
          copyBlock: "A YouTube channel with videos of me playing drum covers.",
          links: [
            {
              label: "Website",
              path: locals.bandersDrums.path,
            }, {
              label: "YouTube",
              url: locals.bandersDrums.youtube,
            }
          ]
        },
      ]
      model.forEach(({ copyBlock, image, heading, links }) => {
    %>
    <%- partial('contributions-card', Object.assign(locals, { copyBlock, image, heading, links })); %>
    <% }); %>
  </div>
  <div class="content">
    <%- blockLink('More', {
      href: '/about/',
    }); %>
  </div>
</section>


  <section class="posts" id="recent-posts">
    <div class="content">
      <header>
        <h2>
          <%- noWidows(`Recent posts`); %>
        </h2>
      </header>
      <%- partial('posts-list', Object.assign(locals, { postCount: 6 })); %>
      <%- blockLink('More posts', { href: '/posts/' }); %>
    </div>
  </section>


  <section class="index-music">
    <div class="content">
      <header>
        <h2>
          <%- noWidows(`Music that I have been listening to`); %>
        </h2>
      </header>
      <div class="last-fm-module p" data-type="albums" src="/images/posts/last-fm/default.webp">
        <% for (let i=0; i < 4; i++) { %>
          <%- defaultLastFMModule(); %>
        <% } %>
      </div>
      <%- blockLink('More music details', { href: '/posts/last-fm/' }); %>
    </div>
  </section>
