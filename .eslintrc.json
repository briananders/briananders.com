{
  "extends": "airbnb-base",
  "env": {
    "browser": true,
    "commonjs": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "globals": {
    "describe": false,
    "it": false,
    "before": false,
    "after": false,
    "afterEach": false,
    "document": true,
    "window": true,
    "browser": true,
    "dataLayer": true
  },
  "rules": {
    "import/no-extraneous-dependencies": 0,
    "import/no-dynamic-require": 0,
    "import/newline-after-import": 0,
    "lines-around-directive": 0,
    "arrow-parens": 0,
    "no-prototype-builtins": 0,
    "no-plusplus": 0,
    "global-require": 0,
    "strict": 0,
    "consistent-return": 0,
    "no-underscore-dangle": 0,
    "no-await-in-loop": 0,
    "no-multi-spaces": 1,
    "no-param-reassign": 0,
    "no-use-before-define": "off",
    "class-methods-use-this": 0,
    "func-names": 0,
    "no-mixed-operators": 0,
    "max-classes-per-file": 0,
    "no-new": 0,
    "no-unused-vars": ["error", {
      "vars": "all",
      "args": "after-used",
      "ignoreRestSiblings": true,
      "argsIgnorePattern": "^_"
    }],
    "no-restricted-globals": ["error", {
      "name": "event",
      "message": "Use local parameter instead."
    }],
    "max-len": ["error", { "code": 120 }],
    "prefer-destructuring": [1, {
      "array": false,
      "object": true
    }, {
      "enforceForRenamedProperties": false
    }],
    "comma-dangle": ["error", {
      "arrays": "never",
      "objects": "always-multiline",
      "imports": "never",
      "exports": "never",
      "functions": "ignore"
    }],
    "no-confusing-arrow": [
      "warn",
      {
        "allowParens": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["build/**/*.js", "bin/**/*.js", "src/js/**/*.js"],
      "rules": {
        "no-console": 0
      }
    },
    {
      "files": ["build/**/*.js"],
      "rules": {
        "import/no-unresolved": ["error", {
          "ignore": ["^svgo$"]
        }]
      }
    }
  ]
}
