{
  "name": "briananders.com",
  "version": "1.1.0",
  "description": "",
  "homepage": "https://briananders.com",
  "scripts": {
    "build": "NODE_ENV=production node index.ts",
    "build:golden": "NODE_ENV=production node index.ts --golden",
    "clean": "rm -rf node_modules tmp dist && npm cache clean --force",
    "convert-js": "node bin/convert-js-to-ts.ts",
    "debug:start": "node index.ts --verbose",
    "debug:build": "NODE_ENV=production node index.ts --verbose",
    "debug:build:golden": "NODE_ENV=production node index.ts --verbose --golden",
    "inspect:build": "NODE_ENV=production node inspect index.ts --verbose",
    "inspect:start": "node inspect index.ts --verbose",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "deploy": "NODE_ENV=production node s3-uploader.ts",
    "lint": "eslint index.ts preview-production.ts s3-uploader.ts scaffold.ts build src/ts bin scaffold test",
    "lint:build": "eslint build --fix",
    "lint:src": "eslint src/ts --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview:production": "node preview-production.ts",
    "preview": "node index.ts",
    "scaffold": "node scaffold.ts",
    "screenshot": "node bin/screenshot.ts",
    "og-images": "node bin/og-images.ts",
    "stage": "node s3-uploader.ts",
    "start": "node index.ts",
    "visual-diff": "node bin/visual-diff.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briananders/briananders.com.git"
  },
  "keywords": [
    "node.js",
    "javascript",
    "static",
    "website"
  ],
  "author": "Brian Anders",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/browserify": "^12.0.40",
    "@types/clean-css": "^4.2.11",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/node-notifier": "^8.0.5",
    "@types/uglify-js": "^3.17.5",
    "@types/underscore.string": "^0.0.42",
    "@types/watchify": "^3.11.4",
    "broken-link-checker": "^0.7.8",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "jshint": "^2.13.6",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1176.0",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/lib-storage": "^3.1176.0",
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@smithy/node-http-handler": "^4.14.2",
    "browserify": "^17.0.1",
    "chokidar": "^6.0.0",
    "clean-css": "^5.3.3",
    "colors": "^1.4.0",
    "copy-to-clipboard": "^4.0.2",
    "ejs": "^7.0.2",
    "empty-dir": "^3.0.0",
    "express": "^5.3.0",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.6",
    "gray-matter": "^4.0.3",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-rename": "^2.1.0",
    "highlight.js": "^11.12.0",
    "html-minifier-terser": "^7.2.0",
    "http-proxy-middleware": "^4.2.2",
    "image-size": "^2.1.0",
    "merge": "^2.1.1",
    "node-notifier": "^12.1.0",
    "png-to-ico": "^3.0.2",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "uglify-js": "^3.19.3",
    "underscore.string": "^3.3.6",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0",
    "watchify": "^4.0.0",
    "xxhash": "^0.3.0"
  },
  "engines": {
    "node": "26.13.1",
    "npm": ">=11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "xxhash@0.3.0": true
  }
}
